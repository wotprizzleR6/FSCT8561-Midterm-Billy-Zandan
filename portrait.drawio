                    <mxGeometry height="115" width="236" x="12" y="55" as="geometry"/>
                </mxCell>
                <mxCell id="c2" parent="client_container" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#ffffff;strokeColor=#000000;" value="2. port_scan() (Local TCP Scanner — Lab 2 + Ch. 2/8)&lt;br&gt;Checks localhost scope (127.0.0.1) and scans ports 8760–8890 using 64 threads (socket.connect_ex or nmap -sT -Pn)." vertex="1">
