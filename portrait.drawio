                <mxCell id="title" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;" value="&lt;b&gt;System Architecture &amp;amp; File Interaction Flowchart&lt;/b&gt;" vertex="1">
                    <mxGeometry height="40" width="810" x="20" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="client_container" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=25;strokeWidth=2;fontSize=11;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" value="&lt;b&gt;client.py&lt;/b&gt;" vertex="1">
                    <mxGeometry height="605" width="260" x="20" y="75" as="geometry"/>
                </mxCell>
                <mxCell id="c1" parent="client_container" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#ffffff;strokeColor=#000000;" value="1. AnalystConsole (Menu UI)&lt;br&gt;Runs the interactive menu with options 1–9, and ?.&amp;nbsp;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;It hides password/OTP input with getpass(), and&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;saves CSV/JSON reports.&lt;/span&gt;" vertex="1">
                    <mxGeometry height="115" width="236" x="12" y="35" as="geometry"/>
                </mxCell>
                <mxCell id="c2" parent="client_container" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#ffffff;strokeColor=#000000;" value="2. port_scan() (Local TCP Scanner)&lt;br&gt;Checks localhost (127.0.0.1) and scans&amp;nbsp;&lt;div&gt;ports 8760–8890 using 64 threads.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="115" width="236" x="12" y="175" as="geometry"/>
                </mxCell>
                <mxCell id="c3" parent="client_container" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#ffffff;strokeColor=#000000;" value="3. http_check() (Local HTTP Checker)&lt;br&gt;Sends normal GET requests to check security&amp;nbsp;&lt;div&gt;headers, cookie flags, and server banners.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="115" width="236" x="12" y="318" as="geometry"/>
                </mxCell>
                <mxCell id="c4" parent="client_container" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#ffffff;strokeColor=#000000;" value="4. SentinelConnection (Framed TCP Client)&lt;br&gt;Connects to 127.0.0.1:8888 and  exchanges&amp;nbsp;&lt;div&gt;newline-delimited JSON  requests and&amp;nbsp;&lt;/div&gt;&lt;div&gt;responses over TCP.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="125" width="236" x="12" y="460" as="geometry"/>
                </mxCell>
                <mxCell id="server_container" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=25;strokeWidth=2;fontSize=11;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" value="&lt;b&gt;server.py (127.0.0.1:8888)&lt;/b&gt;" vertex="1">
                    <mxGeometry height="605" width="310" x="520" y="75" as="geometry"/>
                </mxCell>
                <mxCell id="s1" parent="server_container" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#ffffff;strokeColor=#000000;" value="1. SentinelServer &amp;amp; FramedSocket (TCP Listener)&lt;br&gt;Listens on 127.0.0.1:8888, limits active clients to 10&amp;nbsp;&lt;div&gt;with threading.Lock, and runs one ClientSession thread per client.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="115" width="286" x="12" y="35" as="geometry"/>
                </mxCell>
                <mxCell id="s2" parent="server_container" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#ffffff;strokeColor=#000000;" value="2. cmd_login() &amp;amp; cmd_otp() (Password &amp;amp; TOTP MFA)&lt;br&gt;Step 1: Verifies salted PBKDF2-HMAC-SHA256 hash.&lt;br&gt;Step 2: Verifies 6-digit pyotp TOTP code and blocks replay with last_otp_counter." vertex="1">
                    <mxGeometry height="115" width="286" x="12" y="175" as="geometry"/>
                </mxCell>
                <mxCell id="s3" parent="server_container" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#ffffff;strokeColor=#000000;" value="3. authorize() &amp;amp; audit() (&lt;span style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(139, 148, 158, 0.2) rgb(13, 17, 23); text-align: center;&quot;&gt;&lt;font&gt;RBAC and Audit Logger&lt;/font&gt;&lt;/span&gt;)&lt;br&gt;Checks authenticated session state and roles analyst and admin.&amp;nbsp;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;Writes redacted logs which never logs passwords or OTPs.&lt;/span&gt;" vertex="1">
                    <mxGeometry height="115" width="286" x="12" y="318" as="geometry"/>
                </mxCell>
                <mxCell id="s4" parent="server_container" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#ffffff;strokeColor=#000000;" value="4. analyze_pcap() (Offline Scapy PCAP Analyzer)&lt;br&gt;Validates filename with resolve_pcap(), parses packets via rdpcap(), and detects vertical port scans, SYN bursts, and UDP/53 anomalies." vertex="1">
                    <mxGeometry height="125" width="286" x="12" y="460" as="geometry"/>
                </mxCell>
                <mxCell id="b1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#ffffff;strokeColor=#000000;" value="reports/ Folder (Output Evidence)&lt;br&gt;- port_scan_*.csv&lt;br&gt;- http_observations_*.csv &amp;amp; http_findings_*.csv&lt;br&gt;- pcap_analysis_*.json" vertex="1">
