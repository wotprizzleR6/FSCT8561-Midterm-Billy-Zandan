                <mxCell id="s1" parent="server_container" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#ffffff;strokeColor=#000000;" value="1. SentinelServer &amp;amp; FramedSocket (TCP Listener — Labs 0 &amp;amp; 1 + Ch. 2/3)&lt;br&gt;Listens on 127.0.0.1:8888, limits active clients to 10 (threading.Lock), and runs one ClientSession thread per client." vertex="1">
                    <mxGeometry height="115" width="286" x="12" y="55" as="geometry"/>
                </mxCell>
                <mxCell id="s2" parent="server_container" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#ffffff;strokeColor=#000000;" value="2. cmd_login() &amp;amp; cmd_otp() (Password + TOTP MFA — Lab 3 + Ch. 14)&lt;br&gt;Step 1: Verifies salted PBKDF2-HMAC-SHA256 hash (600,000 iterations).&lt;br&gt;Step 2: Verifies 6-digit pyotp TOTP code and blocks replay via last_otp_counter." vertex="1">
                    <mxGeometry height="115" width="286" x="12" y="190" as="geometry"/>
                </mxCell>
                <mxCell id="s3" parent="server_container" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#ffffff;strokeColor=#000000;" value="3. authorize() &amp;amp; audit() (Role Gatekeeper &amp;amp; Safe Logger — Labs 1 &amp;amp; 3)&lt;br&gt;Checks session state (AUTHENTICATED) and role (analyst vs. admin). Writes redacted logs (never logs passwords or OTPs)." vertex="1">
                    <mxGeometry height="115" width="286" x="12" y="325" as="geometry"/>
                </mxCell>
                <mxCell id="s4" parent="server_container" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#ffffff;strokeColor=#000000;" value="4. analyze_pcap() (Offline Scapy PCAP Analyzer — Lab 4 + Ch. 12)&lt;br&gt;Validates filename with resolve_pcap(), parses packets via rdpcap(), and detects vertical port scans, SYN bursts, and UDP/53 anomalies." vertex="1">
                    <mxGeometry height="125" width="286" x="12" y="460" as="geometry"/>
