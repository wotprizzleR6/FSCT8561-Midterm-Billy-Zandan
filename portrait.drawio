                    <mxGeometry height="115" width="236" x="12" y="325" as="geometry"/>
                </mxCell>
                <mxCell id="c4" parent="client_container" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fillColor=#ffffff;strokeColor=#000000;" value="4. SentinelConnection (Framed TCP Client — Labs 0 &amp;amp; 1)&lt;br&gt;Connects to 127.0.0.1:8888, sends JSON commands ending with , and buffers recv(65536) chunks until ." vertex="1">
                    <mxGeometry height="125" width="236" x="12" y="460" as="geometry"/>
                </mxCell>
                <mxCell id="server_container" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=42;strokeWidth=2;fontSize=11;fillColor=#ffffff;strokeColor=#000000;swimlaneFillColor=#ffffff;" value="&lt;b&gt;server.py — Authenticated TCP Security Server (127.0.0.1:8888)&lt;/b&gt;" vertex="1">
