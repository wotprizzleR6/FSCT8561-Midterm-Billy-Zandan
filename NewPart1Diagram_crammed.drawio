                    </mxGeometry>
                </mxCell>
                <mxCell id="edge_http_web" edge="1" parent="1" source="c_http" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;endArrow=classic;" value="Step 2: Web Security Check on Port 8765&#xa;Inspects test website headers and cookies">
                    <mxGeometry relative="1" targetPoint="" x="-0.2054" as="geometry">
                        <mxPoint y="1" as="offset"/>
                        <Array as="points">
                            <mxPoint x="370" y="338"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="edge_tcp_auth" edge="1" parent="1" source="c_tcp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;fontStyle=1;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=classic;" target="s_auth" value="Step 3: Two-Factor Login on Port 8888&lt;br&gt;Verifies password then asks for&amp;nbsp;&lt;div&gt;6-digit code to unlock the session&lt;/div&gt;">
                    <mxGeometry relative="1" x="-0.1665" y="28" as="geometry">
                        <mxPoint as="offset"/>
