<mxfile host="65bd71144e">
    <diagram id="operation-sentinel-arch" name="Operation Sentinel Architecture">
        <mxGraphModel dx="1018" dy="656" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="850" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="client_container" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontStyle=1;fontSize=13;rounded=0;collapsible=0;" value="client.py&amp;nbsp;" vertex="1">
                    <mxGeometry height="500" width="300" x="40" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="c_ui" parent="client_container" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;spacingLeft=10;" value="&lt;b&gt;1. AnalystConsole (Menu UI)&lt;/b&gt;&lt;br&gt;Runs the interactive menu with options 1–9, and ?.&lt;div&gt;It hides password/OTP input with getpass(), and&amp;nbsp;&lt;/div&gt;&lt;div&gt;saves CSV/JSON reports.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="85" width="264" x="18" y="45" as="geometry"/>
                </mxCell>
                <mxCell id="c_scan" parent="client_container" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;spacingLeft=10;" value="&lt;b&gt;2. port_scan() (Local TCP Scanner)&lt;/b&gt;&lt;br&gt;Checks localhost (127.0.0.1) and scans&amp;nbsp;&lt;div&gt;ports 8760–8890 using 64 threads.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="85" width="264" x="18" y="150" as="geometry"/>
                </mxCell>
                <mxCell id="c_http" parent="client_container" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;spacingLeft=10;" value="&lt;b&gt;3. http_check() (Local HTTP Checker)&lt;/b&gt;&lt;br&gt;Sends normal GET requests to check security&amp;nbsp;&lt;div&gt;headers, cookie flags, and server banners.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="85" width="264" x="18" y="255" as="geometry"/>
                </mxCell>
                <mxCell id="c_tcp" parent="client_container" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;spacingLeft=10;" value="&lt;b&gt;4. SentinelConnection (TCP Client)&lt;/b&gt;&lt;br&gt;Connects to 127.0.0.1:8888 and&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent; animation: 0.2s ease-out 20ms 1 normal both running fade-in;&quot;&gt;exchanges&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent; animation: 0.2s ease-out 40ms 1 normal both running fade-in;&quot;&gt;newline-delimited &lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent; animation: 0.2s ease-out 60ms 1 normal both running fade-in;&quot;&gt;JSON&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent; animation: 0.2s ease-out 80ms 1 normal both running fade-in;&quot;&gt;requests &lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent; animation: 0.2s ease-out 100ms 1 normal both running fade-in;&quot;&gt;and&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent; animation: 0.2s ease-out 120ms 1 normal both running fade-in;&quot;&gt;responses &lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent; animation: 0.2s ease-out 140ms 1 normal both running fade-in;&quot;&gt;over &lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent; animation: 0.2s ease-out 160ms 1 normal both running fade-in;&quot;&gt;TCP&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;&amp;nbsp;.&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="110" width="264" x="18" y="360" as="geometry"/>
                </mxCell>
                <mxCell id="server_container" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontStyle=1;fontSize=13;rounded=0;collapsible=0;" value="server.py" vertex="1">
                    <mxGeometry height="500" width="420" x="540" y="40" as="geometry"/>
                </mxCell>
                <mxCell id="s_listen" parent="server_container" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;spacingLeft=10;" value="&lt;b&gt;1. SentinelServer and FramedSocket (TCP Listener)&lt;/b&gt;&lt;br&gt;Listens on 127.0.0.1:8888, limits active clients to 10&amp;nbsp;&lt;div&gt;with threading.Lock, and runs one ClientSession thread per client.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="85" width="380" x="20" y="45" as="geometry"/>
                </mxCell>
                <mxCell id="s_auth" parent="server_container" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;spacingLeft=10;" value="&lt;b&gt;2. cmd_login() and cmd_otp() (Password and TOTP MFA)&lt;/b&gt;&lt;br&gt;Step 1: Verifies salted PBKDF2-HMAC-SHA256 hash.&lt;br&gt;Step 2: Verifies 6-digit pyotp TOTP code and blocks replay through last_otp_counter." vertex="1">
                    <mxGeometry height="90" width="380" x="20" y="150" as="geometry"/>
                </mxCell>
                <mxCell id="s_rbac" parent="server_container" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;spacingLeft=10;" value="&lt;b&gt;3. authorize() and audit() (RBAC and Audit Logger)&lt;/b&gt;&lt;br&gt;Checks authenticated session state and roles analyst and admin.&amp;nbsp;&lt;div&gt;Writes redacted logs which never logs passwords or OTPs.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="85" width="380" x="20" y="260" as="geometry"/>
                </mxCell>
                <mxCell id="s_pcap" parent="server_container" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;spacingLeft=10;" value="&lt;b&gt;4. analyze_pcap() (Offline Scapy PCAP Analyzer)&lt;/b&gt;&lt;br&gt;Validates filename with resolve_pcap(), parses packets with rdpcap(),&amp;nbsp;&lt;div&gt;and detects vertical port scans, SYN bursts, and UDP/53 anomalies.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="105" width="380" x="20" y="365" as="geometry"/>
                </mxCell>
                <mxCell id="file_reports" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=left;spacingLeft=10;" value="&lt;b&gt;reports/ Folder (Output Evidence)&lt;/b&gt;&lt;br&gt;- port_scan_*.csv&lt;br&gt;- http_observations_*.csv &amp;amp; http_findings_*.csv&lt;br&gt;- pcap_analysis_*.json" vertex="1">
                    <mxGeometry height="115" width="185" x="40" y="590" as="geometry"/>
                </mxCell>
                <mxCell id="file_web" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=left;spacingLeft=10;" value="&lt;b&gt;test_website.py (Local HTTP Target)&lt;/b&gt;&lt;br&gt;Listens on http://127.0.0.1:8765/&lt;br&gt;&lt;span style=&quot;animation: 0.2s ease-out 147ms 1 normal both running fade-in;&quot;&gt;Simulates &lt;/span&gt;&lt;span style=&quot;animation: 0.2s ease-out 147ms 1 normal both running fade-in;&quot;&gt;an &lt;/span&gt;&lt;span style=&quot;animation: 0.2s ease-out 0ms 1 normal both running fade-in;&quot;&gt;insecure &lt;/span&gt;&lt;span style=&quot;animation: 0.2s ease-out 16ms 1 normal both running fade-in;&quot;&gt;web &lt;/span&gt;&lt;span style=&quot;animation: 0.2s ease-out 31ms 1 normal both running fade-in;&quot;&gt;server &lt;/span&gt;&lt;span style=&quot;animation: 0.2s ease-out 47ms 1 normal both running fade-in;&quot;&gt;to &lt;/span&gt;&lt;span style=&quot;animation: 0.2s ease-out 62ms 1 normal both running fade-in;&quot;&gt;test &lt;/span&gt;&lt;span style=&quot;animation: 0.2s ease-out 78ms 1 normal both running fade-in;&quot;&gt;security &lt;/span&gt;&lt;span style=&quot;animation: 0.2s ease-out 94ms 1 normal both running fade-in;&quot;&gt;headers, &lt;/span&gt;&lt;span style=&quot;animation: 0.2s ease-out 109ms 1 normal both running fade-in;&quot;&gt;cookies, &lt;/span&gt;&lt;span style=&quot;animation: 0.2s ease-out 125ms 1 normal both running fade-in;&quot;&gt;and &lt;/span&gt;&lt;span style=&quot;animation: 0.2s ease-out 140ms 1 normal both running fade-in;&quot;&gt;redirects.&lt;/span&gt;" vertex="1">
                    <mxGeometry height="115" width="190" x="235" y="590" as="geometry"/>
                </mxCell>
                <mxCell id="file_users" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=left;spacingLeft=10;" value="&lt;b&gt;users.json (Credential Store)&lt;/b&gt;&lt;br&gt;Stores username, role, salted PBKDF2 hash, Base32 TOTP secret, and last_otp_counter." vertex="1">
                    <mxGeometry height="115" width="165" x="435" y="590" as="geometry"/>
                </mxCell>
                <mxCell id="file_log" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=left;spacingLeft=10;" value="&lt;b&gt;sentinel_audit.log (Audit Log)&lt;/b&gt;&lt;br&gt;Stores timestamped security events with RedactingFilter protection." vertex="1">
                    <mxGeometry height="115" width="165" x="610" y="590" as="geometry"/>
                </mxCell>
                <mxCell id="file_pcap" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=left;spacingLeft=10;" value="Provided .pcap&lt;b&gt;&amp;nbsp;&lt;/b&gt;file is read by server.py." vertex="1">
                    <mxGeometry height="115" width="175" x="785" y="590" as="geometry"/>
                </mxCell>
                <mxCell id="edge_scan_server" edge="1" parent="1" source="c_scan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=classic;" target="s_listen" value="Step 1: Local Port Scan on Ports 8760–8890&#xa;Discovers open ports 8765 and 8888">
                    <mxGeometry relative="1" x="-0.1808" y="10" as="geometry">
                        <mxPoint y="-1" as="offset"/>
                        <Array as="points">
                            <mxPoint x="440" y="232"/>
