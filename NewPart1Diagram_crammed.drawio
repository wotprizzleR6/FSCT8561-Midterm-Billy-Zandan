                </mxCell>
                <mxCell id="edge_client_reports" edge="1" parent="1" source="client_container" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;dashed=1;fontSize=10;fontColor=#000000;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;" target="file_reports" value="Saves CSV &amp; JSON reports">
                    <mxGeometry relative="1" as="geometry">
