                    </mxGeometry>
                </mxCell>
                <mxCell id="edge_tcp_pcap" edge="1" parent="1" source="c_tcp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;fontStyle=1;exitX=0.997;exitY=0.684;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=classic;endArrow=classic;exitPerimeter=0;" target="s_pcap" value="Step 4: Run Protected Server Commands&lt;br&gt;Server inspects packet capture and&amp;nbsp;&lt;div&gt;returns the anomaly report&lt;/div&gt;">
                    <mxGeometry relative="1" x="-0.0698" y="-5" as="geometry">
