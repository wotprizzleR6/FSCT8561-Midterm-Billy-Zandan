                <mxCell id="edge_server_pcap" edge="1" parent="1" source="server_container" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;dashed=1;fontSize=10;fontColor=#000000;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;exitX=0.75;exitY=1;exitDx=0;exitDy=0;" target="file_pcap" value="Reads .pcap with Scapy">
