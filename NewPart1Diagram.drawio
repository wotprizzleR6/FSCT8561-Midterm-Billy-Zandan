                <mxCell id="ThNiG4P637AA0V4ZxosS-27" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;color: rgb(26, 32, 44); text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;Listens on 127.0.0.1:8888, limits active clients to 10, and runs one ClientSession thread per client.&lt;/font&gt;&lt;/span&gt;" vertex="1">
                    <mxGeometry height="60" width="260" x="540" y="70" as="geometry"/>
                </mxCell>
                <mxCell id="ThNiG4P637AA0V4ZxosS-29" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;&lt;span style=&quot;color: rgb(26, 32, 44); text-align: left;&quot;&gt;Step 1: Verifies salted PBKDF2-HMAC-SHA256 hash.&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(139, 148, 158, 0.2) rgb(13, 17, 23); text-align: left;&quot;&gt;&lt;span style=&quot;color: rgb(26, 32, 44); text-align: left;&quot;&gt;Step 2: Verifies 6-digit pyotp TOTP code and blocks replay with last_otp_counter.&lt;/span&gt;&lt;/font&gt;" vertex="1">
                    <mxGeometry height="60" width="260" x="550" y="170" as="geometry"/>
                </mxCell>
                <mxCell id="ThNiG4P637AA0V4ZxosS-31" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;color: rgb(26, 32, 44); text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;Checks session state and which role (analyst or admin). Writes redacted logs and never logs passwords or OTPs.&lt;/font&gt;&lt;/span&gt;" vertex="1">
